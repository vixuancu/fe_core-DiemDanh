# Copy file này thành .env và điền giá trị phù hợp

# Data source: 'mock' hoặc 'api'
VITE_DATA_SOURCE=mock

# Force mock riêng cho module lịch dạy (kể cả khi VITE_DATA_SOURCE=api)
VITE_FORCE_SCHEDULE_MOCK=false

# URL backend (chỉ cần khi VITE_DATA_SOURCE=api)
VITE_API_BASE_URL=http://localhost:8000/api/v1
